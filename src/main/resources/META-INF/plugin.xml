<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>info.chrzanowski.neonglow</id>

    <!-- Public plugin name should be written in Title Case.
     Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>Neon Glow</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://chrzanowski.info">Jakub Chrzanowski</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        Configurable neon glow for JetBrains IDEs. Keep your theme, add some light.<br><br>
        Add text and icon halos with independent editor/UI/icon switches and strengths,
        manual glow controls and bounded cold-cache work in performance mode.<br><br>
        Optional SynthWave-inspired dark themes coordinate editor, console and terminal palettes and recolour
        standard icons. Choose Neon Glow, Neon Glow Midnight or Neon Glow Accessible under
        <b>Settings | Appearance &amp; Behavior | Appearance</b>.<br><br>
        The glow is static (no animation), respects Power Save mode, follows colour scheme changes and can be tuned or
        switched off under <b>Settings | Appearance &amp; Behavior | Neon Glow</b> or via
        <b>View | Appearance | Neon Glow</b>.
        ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>

    <resource-bundle>messages.NeonGlowBundle</resource-bundle>

    <!-- Extensions defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <themeProvider id="info.chrzanowski.neonglow.theme.classic" path="/themes/neon-glow.theme.json"/>
        <themeProvider id="info.chrzanowski.neonglow.theme.midnight" path="/themes/neon-glow-midnight.theme.json"/>
        <themeProvider id="info.chrzanowski.neonglow.theme.accessible" path="/themes/neon-glow-accessible.theme.json"/>
        <editorFactoryListener implementation="info.chrzanowski.neonglow.editor.GlowEditorFactoryListener"/>
        <postStartupActivity implementation="info.chrzanowski.neonglow.ui.GlowStartupActivity"/>

        <applicationConfigurable
                groupId="appearance"
                instance="info.chrzanowski.neonglow.settings.GlowConfigurable"
                id="info.chrzanowski.neonglow.settings.GlowConfigurable"
                displayName="Neon Glow"/>
    </extensions>

    <applicationListeners>
        <listener class="info.chrzanowski.neonglow.listeners.GlowApplicationListener"
                  topic="com.intellij.ide.AppLifecycleListener"/>
        <!-- Colour scheme switched or edited (a LaF change switches the scheme too): recolour the glow. -->
        <listener class="info.chrzanowski.neonglow.listeners.GlowColorsListener"
                  topic="com.intellij.openapi.editor.colors.EditorColorsListener"/>
        <listener class="info.chrzanowski.neonglow.listeners.GlowPowerSaveListener"
                  topic="com.intellij.ide.PowerSaveMode$Listener"/>
    </applicationListeners>

    <actions>
        <!-- View | Appearance | Neon Glow; text/description come from the resource bundle. -->
        <action id="info.chrzanowski.neonglow.ToggleGlowAction"
                class="info.chrzanowski.neonglow.actions.ToggleGlowAction">
            <add-to-group group-id="UIToggleActions" anchor="last"/>
        </action>
        <group id="info.chrzanowski.neonglow.Tools" popup="true">
            <add-to-group group-id="UIToggleActions" anchor="last"/>
            <action id="info.chrzanowski.neonglow.OpenGlowSettingsAction"
                    class="info.chrzanowski.neonglow.actions.OpenGlowSettingsAction"/>
            <action id="info.chrzanowski.neonglow.ClearGlowCachesAction"
                    class="info.chrzanowski.neonglow.actions.ClearGlowCachesAction"/>
            <action id="info.chrzanowski.neonglow.CopyGlowDiagnosticsAction"
                    class="info.chrzanowski.neonglow.actions.CopyGlowDiagnosticsAction"/>
        </group>
    </actions>

</idea-plugin>
