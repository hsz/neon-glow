<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>info.chrzanowski.neonglow</id>

    <!-- Public plugin name should be written in Title Case.
     Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>Neon Glow</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://github.com/hsz">Jakub Chrzanowski</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        Neon Glow is a free and open-source plugin for JetBrains IDEs. Keep your theme, add some light.<br><br>
        Neon Glow paints a soft, blurred halo behind text and icons across the whole IDE: editor, tool windows,
        tabs, menus, popups and dialogs. Coloured code gets layered neon in the style of SynthWave '84.
        Plain text stays crisp unless you ask for it to glow too.<br><br>
        <b>Settings</b> (<code>Settings | Appearance &amp; Behavior | Neon Glow</code>)
        <ul>
          <li>Separate switches and strengths for editor text, UI text and icons</li>
          <li>Brightness, radius and intensity sliders</li>
          <li>Neon text styling on or off, regular text glow on or off</li>
          <li>Performance mode that caps new glow work per repaint</li>
          <li>Quick toggle: <code>View | Appearance | Neon Glow</code></li>
        </ul>
        Changes apply without restarting the IDE. Glow is static (no animation) and switches itself off in Power Save mode.<br><br>
        <b>Themes</b> (optional)<br>
        Three dark themes with matching editor, console and terminal colours: Neon Glow, Neon Glow Midnight
        and Neon Glow Accessible. Pick one under <code>Settings | Appearance &amp; Behavior | Appearance</code>, or keep
        the theme you already use. Themes and glow are independent.<br><br>
        <b>Good to know</b><br>
        The glow is drawn with Java2D and covers Swing text and standard icons. Native menu bars, embedded browsers,
        terminal panes that bypass Swing text drawing and icons painted from vector shapes are not covered.<br><br>
        Inspired by Robb Owen's <a href="https://github.com/robb0wen/synthwave-vscode">SynthWave '84</a> for VS Code,
        with no affiliation to its author. A personal project, not an official JetBrains product.
        ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>

    <resource-bundle>messages.NeonGlowBundle</resource-bundle>

    <!-- Extensions defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <themeProvider id="info.chrzanowski.neonglow.theme.classic" path="/themes/neon-glow.theme.json"/>
        <themeProvider id="info.chrzanowski.neonglow.theme.midnight" path="/themes/neon-glow-midnight.theme.json"/>
        <themeProvider id="info.chrzanowski.neonglow.theme.accessible" path="/themes/neon-glow-accessible.theme.json"/>
        <editorFactoryListener implementation="info.chrzanowski.neonglow.editor.GlowEditorFactoryListener"/>
        <postStartupActivity implementation="info.chrzanowski.neonglow.ui.GlowStartupActivity"/>

        <applicationConfigurable
                groupId="appearance"
                instance="info.chrzanowski.neonglow.settings.GlowConfigurable"
                id="info.chrzanowski.neonglow.settings.GlowConfigurable"
                displayName="Neon Glow"/>
    </extensions>

    <applicationListeners>
        <listener class="info.chrzanowski.neonglow.listeners.GlowDynamicPluginListener"
                  topic="com.intellij.ide.plugins.DynamicPluginListener"/>
        <listener class="info.chrzanowski.neonglow.listeners.GlowApplicationListener"
                  topic="com.intellij.ide.AppLifecycleListener"/>
        <!-- Colour scheme switched or edited (a LaF change switches the scheme too): recolour the glow. -->
        <listener class="info.chrzanowski.neonglow.listeners.GlowColorsListener"
                  topic="com.intellij.openapi.editor.colors.EditorColorsListener"/>
        <listener class="info.chrzanowski.neonglow.listeners.GlowPowerSaveListener"
                  topic="com.intellij.ide.PowerSaveMode$Listener"/>
    </applicationListeners>

    <actions>
        <!-- View | Appearance | Neon Glow; text/description come from the resource bundle. -->
        <action id="info.chrzanowski.neonglow.ToggleGlowAction"
                class="info.chrzanowski.neonglow.actions.ToggleGlowAction">
            <add-to-group group-id="UIToggleActions" anchor="last"/>
        </action>
        <group id="info.chrzanowski.neonglow.Tools" popup="true">
            <add-to-group group-id="UIToggleActions" anchor="last"/>
            <action id="info.chrzanowski.neonglow.OpenGlowSettingsAction"
                    class="info.chrzanowski.neonglow.actions.OpenGlowSettingsAction"/>
            <action id="info.chrzanowski.neonglow.ClearGlowCachesAction"
                    class="info.chrzanowski.neonglow.actions.ClearGlowCachesAction"/>
            <action id="info.chrzanowski.neonglow.CopyGlowDiagnosticsAction"
                    class="info.chrzanowski.neonglow.actions.CopyGlowDiagnosticsAction"/>
        </group>
    </actions>

</idea-plugin>
