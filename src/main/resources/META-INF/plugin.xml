<idea-plugin>
    <id>info.chrzanowski.idesynthwave</id>
    <name>IDE Synthwave</name>
    <vendor url="https://chrzanowski.info">Jakub Chrzanowski</vendor>
    <description>A SynthWave-inspired theme for JetBrains IDEs.</description>
    <depends>com.intellij.modules.platform</depends>
    <resource-bundle>messages.SynthwaveBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <themeProvider id="info.chrzanowski.idesynthwave.theme.classic" path="/themes/synthwave.theme.json"/>
        <editorFactoryListener implementation="info.chrzanowski.idesynthwave.editor.GlowEditorFactoryListener"/>
        <applicationConfigurable groupId="appearance"
                                instance="info.chrzanowski.idesynthwave.settings.GlowConfigurable"
                                id="info.chrzanowski.idesynthwave.settings.GlowConfigurable"
                                displayName="Synthwave"/>
    </extensions>

    <applicationListeners>
        <listener class="info.chrzanowski.idesynthwave.listeners.GlowColorsListener"
                  topic="com.intellij.openapi.editor.colors.EditorColorsListener"/>
        <listener class="info.chrzanowski.idesynthwave.listeners.GlowPowerSaveListener"
                  topic="com.intellij.ide.PowerSaveMode$Listener"/>
    </applicationListeners>

    <actions>
        <action id="info.chrzanowski.idesynthwave.ToggleGlowAction"
                class="info.chrzanowski.idesynthwave.actions.ToggleGlowAction">
            <add-to-group group-id="UIToggleActions" anchor="last"/>
        </action>
    </actions>
</idea-plugin>